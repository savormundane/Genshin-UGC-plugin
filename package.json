{
  "name": "dsh-miliastra-wonderland",
  "version": "1.3.1",
  "description": "Look up nodes and Lua APIs, inspect levels, and create node graphs and assets for Genshin Impact's Miliastra Wonderland.",
  "icon": "./assets/icon.png",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/savormundane/miliastra-wonderland-plugin.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "dsh": "0.2.2-rc.5 || 0.2.3-alpha.2"
  },
  "files": [
    "cordis.patch.yml",
    "plugin.json",
    "locale/",
    "assets/",
    "docs/",
    "references/",
    "skills/",
    "scripts/",
    "samples/",
    "vendor/",
    "pyproject.toml",
    "uv.lock",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "PUBLIC_SOURCES.json",
    "!.ruff_cache/**",
    "!node_modules/**",
    "!samples/seeds/**",
    "!.github/**",
    "!vendor/beyond/node_modules/gifuct-js/demo/**",
    "!vendor/beyond/node_modules/js-binary-schema-parser/example/**",
    "!vendor/beyond/node_modules/fengari/test/**",
    "!runtime.json",
    "!public-files.txt",
    "!.agents/plugins/marketplace.json",
    "!.claude-plugin/marketplace.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  }
}
